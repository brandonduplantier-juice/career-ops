# career-ops — Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env

# ── Gemini Integration (Issue #344) ─────────────────────────────────────────
# Required for: node gemini-eval.mjs "JD text here"
# Free API key: https://aistudio.google.com/apikey
# Free tier: 15 RPM / 1M tokens/day with gemini-2.0-flash (no billing needed)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: Override default Gemini model ───────────────────────────────────
# Default: gemini-2.0-flash (free-tier, fast)
# Alternatives: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash-thinking-exp
# GEMINI_MODEL=gemini-2.0-flash

# ── Morning Brief Email (Gmail SMTP, port 587 STARTTLS) ──────────────────────
# Required for: node morning_brief.mjs
# Generate an App Password at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification on your Google account)
CAREER_OPS_GMAIL_APP_PW=your_gmail_app_password_here

# ── Adzuna job aggregator (optional) ─────────────────────────────────────────
# Register free at: https://developer.adzuna.com/
# Used by: node ats_scan.mjs (Adzuna aggregator source)
# Without these, Adzuna is silently skipped.
# ADZUNA_APP_ID=your_adzuna_app_id_here
# ADZUNA_APP_KEY=your_adzuna_app_key_here

# ── USAJobs API (optional, US federal jobs) ───────────────────────────────────
# Register free at: https://developer.usajobs.gov/
# USAJOBS_EMAIL must match the email you registered with.
# Without these, USAJobs is silently skipped.
# USAJOBS_API_KEY=your_usajobs_api_key_here
# USAJOBS_EMAIL=your_registered_email@example.com

# ── Other integrations (add your own below) ──────────────────────────────────
# ANTHROPIC_API_KEY=your_anthropic_key_here   # For Claude-based workflows
# OPENAI_API_KEY=your_openai_key_here          # Future OpenAI integration
